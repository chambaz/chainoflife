{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "noEmit": true,
    "allowJs": true,
    "types": ["node"]
  },
  "include": [
    "vite.config.ts",
    "playwright*.ts",
    "scripts/**/*.ts",
    "scripts/**/*.mjs",
    "tests/browser/**/*.ts",
    "tests/live/**/*.ts",
    "tests/support/**/*.ts",
    "vite.config.test.ts"
  ]
}
